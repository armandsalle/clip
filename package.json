{
  "name": "clip",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r test && vp run -r build",
    "dev": "vp run @clip/web#dev",
    "deploy": "vp run @clip/jobs#deploy && vp run @clip/api#deploy && vp run @clip/web#deploy",
    "prepare": "vp config && effect-tsgo patch --typescript --oxlint"
  },
  "devDependencies": {
    "@clip/config": "workspace:*",
    "@effect/tsgo": "catalog:",
    "@neon/config": "catalog:",
    "@neon/env": "catalog:",
    "@types/node": "catalog:",
    "neonctl": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
